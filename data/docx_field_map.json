{
  "version": "2.0",
  "templateFile": "docs/templates/anhang_angebot_vorlage.docx",
  "engine": "docxtpl (Jinja2)",
  "annexSourceFile": "docs/manuals/2.8/Anhang zu Software_v2.6.X.docx",
  "notes": [
    "Ein Dokument: SSI-Software-Anhang mit eingebetteten Platzhaltern.",
    "Export befüllt nur anhang_angebot_vorlage.docx — kein Voranstellen einer zweiten Datei.",
    "Einfache Felder: {{feldname}}",
    "Optionen, Bedingungen und Leistungsumfang vorgerendert: optionen_text, bedingungen_text, leistungsumfang_text",
    "Vorlage neu aus Original erzeugen: python scripts/build_annex_template.py"
  ],
  "fields": [
    { "name": "dokument_label", "label": "Dokumentkennzeichnung", "example": "Angebot / Preisliste", "section": "deckblatt" },
    { "name": "titel", "label": "Dokumenttitel", "example": "Angebot WAMAS® Lift & Store", "section": "deckblatt" },
    { "name": "untertitel", "label": "Untertitel", "example": "SSI SCHÄFER · Softwarelösung…", "section": "deckblatt" },
    { "name": "meta_zeile", "label": "Meta-Zeile (Nr./Datum/Gültig/Rev.)", "example": "Angebot ANG-… · 17.07.2026 · Gültig bis …", "section": "deckblatt" },
    { "name": "angebotsnummer", "label": "Angebotsnummer", "example": "ANG-20260717-ABC123", "section": "meta" },
    { "name": "datum", "label": "Angebotsdatum", "example": "17.07.2026", "section": "meta" },
    { "name": "gueltig_bis", "label": "Gültig bis", "example": "31.07.2026", "section": "meta" },
    { "name": "version_software", "label": "Software-Version", "example": "2.8", "section": "meta" },
    { "name": "erstellt_von", "label": "Erstellt von", "example": "Florian Brunner", "section": "meta" },
    { "name": "revision_von", "label": "Revision von (falls vorhanden)", "example": "ANG-20260717-ALT", "section": "meta" },
    { "name": "kunde", "label": "Kunde / Firma", "example": "Muster AG", "section": "kunde" },
    { "name": "projekt", "label": "Projektname", "example": "LOGIMAT Halle 3", "section": "kunde" },
    { "name": "ansprechpartner", "label": "Ansprechpartner Kunde", "example": "Max Beispiel", "section": "kunde" },
    { "name": "email", "label": "E-Mail Kunde", "example": "max@muster.ch", "section": "kunde" },
    { "name": "adresse", "label": "Adresse Kunde", "example": "Musterweg 1, 8000 Zürich", "section": "kunde" },
    { "name": "konfiguration", "label": "Konfiguration Kurztext", "example": "Advanced Instance (1×) · 1 Gerät · 2 Öffnungen", "section": "konfiguration" },
    { "name": "einleitung", "label": "Einleitungstext (vorgerendert)", "example": "Die Softwarelösung …", "section": "inhalt" },
    { "name": "leistungsumfang_text", "label": "Leistungsumfang (vorgerendert)", "example": "A · Softwarelizenzen\n• …", "section": "inhalt" },
    { "name": "optionen_text", "label": "Optionen (vorgerendert)", "example": "• RFID Login\n…", "section": "inhalt" },
    { "name": "bedingungen_text", "label": "Kaufmännische Bedingungen (vorgerendert)", "example": "1.1 Geltung\n…", "section": "bedingungen" },
    { "name": "terms_version", "label": "Bedingungen Version", "example": "09.2022", "section": "bedingungen" },
    { "name": "preis_hinweis", "label": "Preis-/Währungshinweis", "example": "Alle Preise in CHF, exkl. MwSt.", "section": "preise" },
    { "name": "lizenz_total_chf", "label": "Softwarelizenzen Verkauf CHF", "example": "CHF 9'951.74", "section": "preise" },
    { "name": "it_total_chf", "label": "IT-Aufwand Total CHF", "example": "CHF 23'215.00", "section": "preise" },
    { "name": "gesamt_chf", "label": "Gesamttotal CHF", "example": "CHF 33'166.74", "section": "preise" },
    { "name": "schluss_text", "label": "Schlusstext Auftrag", "example": "Ihrem Auftrag … entgegen.", "section": "schluss" },
    { "name": "gruss", "label": "Grussformel", "example": "Freundliche Grüsse", "section": "schluss" },
    { "name": "firma_ssi", "label": "Firma SSI", "example": "SSI SCHÄFER AG", "section": "schluss" },
    { "name": "signatur_1_name", "label": "Unterschrift 1 Name", "example": "Florian Brunner", "section": "schluss" },
    { "name": "signatur_1_titel", "label": "Unterschrift 1 Titel", "example": "Bereichsleiter …", "section": "schluss" },
    { "name": "signatur_1_rolle", "label": "Unterschrift 1 Rolle", "example": "Mitglied der Geschäftsleitung", "section": "schluss" },
    { "name": "signatur_2_name", "label": "Unterschrift 2 Name", "example": "Andrej Pulfer", "section": "schluss" },
    { "name": "signatur_2_titel", "label": "Unterschrift 2 Titel", "example": "Leiter Vertrieb …", "section": "schluss" }
  ],
  "lists": []
}
